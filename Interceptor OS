-- Workspace Storage Management (UNTOUCHED)
-- ==========================================
local dumpFolder = "PayloadDumps"
local webhookLogFile = dumpFolder .. "/Intercepted_Webhooks.txt"

if isfolder and not isfolder(dumpFolder) then
    pcall(makefolder, dumpFolder)
end

local function writeToWorkspace(filename, content)
    if writefile then
        local path = dumpFolder .. "/" .. filename
        local ok, err = pcall(writefile, path, content)
        return ok, path or err
    end
    return false, "writefile not supported"
end

local function logWebhookToFile(url)
    if appendfile then
        pcall(appendfile, webhookLogFile, url .. "\n")
    elseif writefile then
        pcall(writefile, dumpFolder .. "/Webhook_" .. tostring(math.floor(os.clock() * 1000)) .. ".txt", url)
    end
end

