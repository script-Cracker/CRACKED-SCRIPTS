-- ==========================================
-- Logic Processors (UNTOUCHED)
-- ==========================================
local function processWebhook(url, method)
    logWebhookToFile(url)
    addCard({
        type = "Webhook",
        title = url,
        source = "Outbound Hook",
        size_or_status = "BLOCKED (" .. tostring(method) .. ")",
        time = os.date("%X"),
        url = url
    })
    warn("[Interceptor] Blocked malicious webhook request to: " .. url)
end

local function processPayload(content, source)
    if type(content) ~= "string" then return end
    
    if string.find(content, "[https://lura.ph/]", 1, true) then return end

    local byteLen = #content
    local sizeFormat = byteLen > 1024 and string.format("%.1f KB", byteLen / 1024) or string.format("%d B", byteLen)
    local timestamp = os.date("%X")
    local filename = string.format("%s_%s.luau", source, tostring(math.floor(os.clock() * 1000)))

    writeToWorkspace(filename, content)

    addCard({
        type = "Payload",
        title = filename,
        source = source,
        size_or_status = sizeFormat,
        time = timestamp,
        content = content
    })
end

-- ==========================================
-- Mobile & PC UI Dragging Logic (UNTOUCHED)
-- ==========================================
local dragging = false
local dragStart, startPos, dragInput

Topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

Topbar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ==========================================
-- Comprehensive Intercept Hooks (UNTOUCHED)
-- ==========================================
if hookfunction and getgenv then
    local env = getgenv()

    if env.loadstring then
        local oldLoadstring
        oldLoadstring = hookfunction(env.loadstring, function(chunk, chunkName)
            if type(chunk) == "string" and #chunk > 1000 and chunkName ~= "=FlowAuthRuntime" then
                processPayload(chunk, "Compiler")
            end
            return oldLoadstring(chunk, chunkName)
        end)
    end

    local function createRequestHook(originalFunc, sourceName)
        local oldReq
        oldReq = hookfunction(originalFunc, function(options)
            if type(options) == "table" and type(options.Url) == "string" then
                local url = string.lower(options.Url)
                if string.find(url, "discord.com/api/webhooks") or string.find(url, "discordapp.com/api/webhooks") or string.find(url, "webhook.site") then
                    processWebhook(options.Url, options.Method or "POST")
                    return {
                        Success = true,
                        StatusCode = 200,
                        StatusMessage = "OK",
                        Body = '{"message": "Blocked by Interceptor"}',
                        Headers = {}
                    }
                end
            end

            local res = oldReq(options)

            if type(res) == "table" and type(res.Body) == "string" and #res.Body > 1000 then
                if not string.find(res.Body, "<!DOCTYPE html>") then
                    processPayload(res.Body, "Network (" .. sourceName .. ")")
                end
            end
            
            return res
        end)
    end

    local globalAliases = {
        "request", "http_request", "httprequest", "httpRequest"
    }

    local tableAliases = {
        "syn", "fluxus", "http"
    }

    for _, alias in ipairs(globalAliases) do
        if type(env[alias]) == "function" then
            createRequestHook(env[alias], alias)
        end
    end

    for _, tableName in ipairs(tableAliases) do
        local t = env[tableName]
        if type(t) == "table" and type(t.request) == "function" then
            createRequestHook(t.request, tableName .. ".request")
        end
    end
end

